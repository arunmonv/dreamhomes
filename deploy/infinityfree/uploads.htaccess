# Uploads folder: serve images only, never execute scripts
<FilesMatch "(?i)\.(php\d?|phtml|phar|pl|py|cgi|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
Options -ExecCGI -Indexes
RemoveHandler .php .phtml .phar
