APP_NAME="Dream Homes"
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_URL=https://CHANGE-ME.example.com

LOG_CHANNEL=single
LOG_LEVEL=error

# From InfinityFree control panel -> MySQL Databases
DB_CONNECTION=mysql
DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_XXXXXXXX_dreamhomes
DB_USERNAME=if0_XXXXXXXX
DB_PASSWORD=CHANGE-ME

SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# No symlinks on shared hosting: store uploads directly in htdocs/storage
UPLOADS_IN_PUBLIC=true
