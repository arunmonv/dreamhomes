# Production template: copy to .env on the server and fill in. NEVER commit the real .env.
APP_NAME="Dream Homes"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                       # generate locally: php artisan key:generate --show
APP_URL=https://yourdomain.com

LOG_CHANNEL=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_SECURE_COOKIE=true     # cookies only over HTTPS
SESSION_SAME_SITE=lax
CACHE_STORE=file

ADMIN_EMAIL=
ADMIN_PASSWORD=                # strong, 14+ chars; used only when seeding
